OUTFILE=vcmailbox

OBJECTS=vcmailbox.o

all: $(OUTFILE)

clean:
	@delete $(OBJECTS)

$(OUTFILE): $(OBJECTS)
	sc MATH=STANDARD CHKABORT NOICONS STRIPDEBUG LINK $(OBJECTS)
